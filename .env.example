# ArthaPilot Environment Configuration
DATABASE_URL=sqlite:///./arthapilot.db
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Demo Seeding & Data
SEED_DEMO=true
DATA_DIR=

# Copilot / LLM Configuration (provider-agnostic: none, anthropic, gemini, ollama)
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Rate Limits & Ops
CHAT_RATE_LIMIT_PER_MIN=10
UPLOAD_MAX_SIZE_MB=10
LOG_LEVEL=INFO
